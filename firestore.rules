rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return signedIn() && exists(userPath());
    }

    function userRole() {
      return userExists() ? get(userPath()).data.role : null;
    }

    function isNonNegativeNumber(value) {
      return value is number && value >= 0;
    }

    function isClosingPayload(document) {
      return request.resource.data.keys().hasAll([
        'businessDate',
        'status',
        'sales',
        'customers',
        'nominations',
        'castSales',
        'staffWork',
        'castWork',
        'cashReconciliation',
        'source'
      ])
      && request.resource.data.businessDate == document
      && request.resource.data.businessDate is string
      && request.resource.data.businessDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
      && (request.resource.data.status == 'submitted' || request.resource.data.status == 'approved')
      && request.resource.data.sales is map
      && isNonNegativeNumber(request.resource.data.sales.totalSales)
      && isNonNegativeNumber(request.resource.data.sales.cashSales)
      && isNonNegativeNumber(request.resource.data.sales.cardSales)
      && request.resource.data.customers is map
      && isNonNegativeNumber(request.resource.data.customers.groupCount)
      && isNonNegativeNumber(request.resource.data.customers.totalCustomers)
      && isNonNegativeNumber(request.resource.data.customers.customerUnitPrice)
      && request.resource.data.nominations is map
      && isNonNegativeNumber(request.resource.data.nominations.honShimeiCount)
      && isNonNegativeNumber(request.resource.data.nominations.jonaiCount)
      && request.resource.data.castSales is list
      && request.resource.data.staffWork is list
      && request.resource.data.castWork is list
      && request.resource.data.cashReconciliation is map
      && request.resource.data.source is map;
    }

    match /dailyReports/{document} {
      allow read: if signedIn() && (userRole() == 'shop' || userRole() == 'accounting');
      allow create, update: if signedIn() && userRole() == 'shop';
      allow delete: if false;
    }

    match /dailyReports-dev/{document} {
      allow read: if signedIn() && (userRole() == 'shop' || userRole() == 'accounting');
      allow create, update: if signedIn() && userRole() == 'shop';
      allow delete: if false;
    }

    match /dailyClosings/{document} {
      allow read: if signedIn() && (userRole() == 'shop' || userRole() == 'accounting');
      allow create, update: if signedIn() && userRole() == 'shop';
      allow delete: if false;
    }

    match /dailyClosings-dev/{document} {
      allow read: if signedIn() && (userRole() == 'shop' || userRole() == 'accounting');
      allow create, update: if signedIn() && userRole() == 'shop';
      allow delete: if false;
    }

    match /shopClosings/{document} {
      allow read: if signedIn() && userRole() == 'shop';
      allow create, update: if (isClosingPayload(document) && request.resource.data.status == 'submitted') || (signedIn() && userRole() == 'shop');
      allow delete: if false;
    }

    match /shopClosings-dev/{document} {
      allow read: if signedIn() && userRole() == 'shop';
      allow create, update: if (isClosingPayload(document) && request.resource.data.status == 'submitted') || (signedIn() && userRole() == 'shop');
      allow delete: if false;
    }

    match /staffMembers/{document} {
      allow read: if signedIn() && (userRole() == 'shop' || userRole() == 'accounting');
      allow create, update, delete: if signedIn() && userRole() == 'shop';
    }

    match /staffMembers-dev/{document} {
      allow read: if signedIn() && (userRole() == 'shop' || userRole() == 'accounting');
      allow create, update, delete: if signedIn() && userRole() == 'shop';
    }

    match /castMembers/{document} {
      allow read: if signedIn() && (userRole() == 'shop' || userRole() == 'accounting');
      allow create, update, delete: if signedIn() && userRole() == 'shop';
    }

    match /castMembers-dev/{document} {
      allow read: if signedIn() && (userRole() == 'shop' || userRole() == 'accounting');
      allow create, update, delete: if signedIn() && userRole() == 'shop';
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
