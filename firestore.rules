rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return signedIn() && exists(userPath());
    }

    function authRole() {
      return signedIn()
        && request.auth.token.keys().hasAny(['role'])
        && (request.auth.token.role == 'shop'
          || request.auth.token.role == 'accounting')
        ? request.auth.token.role
        : null;
    }

    function userRole() {
      return authRole() != null
        ? authRole()
        : (userExists() ? get(userPath()).data.role : null);
    }

    function isSelfSubmittedClosing() {
      return signedIn()
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.businessDate is string
        && request.resource.data.businessDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.status == 'submitted';
    }

    function isSelfFinalizedClosing() {
      return signedIn()
        && request.resource.data.finalizedBy == request.auth.uid
        && request.resource.data.businessDate is string
        && request.resource.data.businessDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.status == 'finalized';
    }

    function isNonNegativeNumber(value) {
      return value is number && value >= 0;
    }

    function isStaffMember() {
      return request.resource.data.keys().hasAll([
        'name',
        'employmentType',
        'jobType',
        'payType',
        'payAmount',
        'status'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 40
      && (request.resource.data.employmentType == 'employee'
        || request.resource.data.employmentType == 'partTime')
      && (request.resource.data.employmentType == 'employee'
        ? (request.resource.data.jobType == ''
          && request.resource.data.payType == ''
          && request.resource.data.payAmount == 0)
          || ((request.resource.data.jobType == 'kitchen'
            || request.resource.data.jobType == 'hall'
            || request.resource.data.jobType == 'driver')
            && (request.resource.data.payType == 'daily'
              || request.resource.data.payType == 'hourly')
            && request.resource.data.payAmount is int
            && request.resource.data.payAmount > 0)
        : (request.resource.data.jobType == 'kitchen'
          || request.resource.data.jobType == 'hall'
          || request.resource.data.jobType == 'driver')
          && (request.resource.data.payType == 'daily'
            || request.resource.data.payType == 'hourly')
          && request.resource.data.payAmount is int
          && request.resource.data.payAmount > 0)
      && (request.resource.data.status == 'active'
        || request.resource.data.status == 'departed');
    }

    function isCastMember() {
      return request.resource.data.keys().hasAll([
        'posCastId',
        'name',
        'internalNo',
        'status',
        'source'
      ])
      && request.resource.data.posCastId is string
      && request.resource.data.posCastId.size() > 0
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 40
      && request.resource.data.internalNo is number
      && request.resource.data.internalNo >= 0
      && (request.resource.data.status == 'active'
        || request.resource.data.status == 'departed'
        || request.resource.data.status == 'trial')
      && request.resource.data.source == 'pos'
      && (!request.resource.data.keys().hasAny(['deleted'])
        || request.resource.data.deleted is bool)
      && (!request.resource.data.keys().hasAny(['rewardSystem'])
        || request.resource.data.rewardSystem == ''
        || request.resource.data.rewardSystem == 'slideHourly'
        || request.resource.data.rewardSystem == 'guaranteedHourly')
      && (!request.resource.data.keys().hasAny(['guaranteeNote'])
        || (request.resource.data.guaranteeNote is string
          && request.resource.data.guaranteeNote.size() <= 200))
      && (!request.resource.data.keys().hasAny(['guaranteedHourlyRate'])
        || (request.resource.data.guaranteedHourlyRate is int
          && request.resource.data.guaranteedHourlyRate >= 0))
      && (!request.resource.data.keys().hasAny(['hourlyRate'])
        || (request.resource.data.hourlyRate is int
          && request.resource.data.hourlyRate >= 0))
      && (!request.resource.data.keys().hasAny(['introducerId'])
        || (request.resource.data.introducerId is string
          && request.resource.data.introducerId.size() <= 100))
      && (!request.resource.data.keys().hasAny(['introducerName'])
        || (request.resource.data.introducerName is string
          && request.resource.data.introducerName.size() <= 40))
      && (!request.resource.data.keys().hasAny(['introducerFeeSystem'])
        || request.resource.data.introducerFeeSystem == ''
        || request.resource.data.introducerFeeSystem == 'sales10'
        || request.resource.data.introducerFeeSystem == 'pay10'
        || request.resource.data.introducerFeeSystem == 'higher10')
      && (!request.resource.data.keys().hasAny(['advisoryFeeEnabled'])
        || request.resource.data.advisoryFeeEnabled is bool)
      && (!request.resource.data.keys().hasAny(['advisoryFeeAmount'])
        || (request.resource.data.advisoryFeeAmount is int
          && request.resource.data.advisoryFeeAmount >= 0))
      && (!request.resource.data.keys().hasAny(['entryDate'])
        || (request.resource.data.entryDate is string
          && (request.resource.data.entryDate == ''
            || request.resource.data.entryDate.matches('^\\d{4}-\\d{2}-\\d{2}$')))
      )
      && (!request.resource.data.keys().hasAny(['note'])
        || (request.resource.data.note is string
          && request.resource.data.note.size() <= 500))
      && (!request.resource.data.keys().hasAny(['personKey'])
        || (request.resource.data.personKey is string
          && request.resource.data.personKey.size() > 0
          && request.resource.data.personKey.size() <= 120))
      && (!request.resource.data.keys().hasAny(['sourceTrialCastId'])
        || (request.resource.data.sourceTrialCastId is string
          && request.resource.data.sourceTrialCastId.size() <= 120))
      && (!request.resource.data.keys().hasAny(['convertedFromTrial'])
        || request.resource.data.convertedFromTrial is bool)
      && (!request.resource.data.keys().hasAny(['convertedTrialName'])
        || (request.resource.data.convertedTrialName is string
          && request.resource.data.convertedTrialName.size() <= 40))
      && (!request.resource.data.keys().hasAny(['previousNames'])
        || request.resource.data.previousNames is list)
      && (!request.resource.data.keys().hasAny(['previousPosCastIds'])
        || request.resource.data.previousPosCastIds is list)
      && (!request.resource.data.keys().hasAny(['rewardSystem'])
        || request.resource.data.rewardSystem != 'guaranteedHourly'
        || (request.resource.data.keys().hasAny(['guaranteeNote'])
          && request.resource.data.guaranteeNote.size() > 0
          && request.resource.data.keys().hasAny(['guaranteedHourlyRate'])
          && request.resource.data.guaranteedHourlyRate > 0))
      && (!request.resource.data.keys().hasAny(['advisoryFeeEnabled'])
        || request.resource.data.advisoryFeeEnabled == false
        || request.resource.data.status == 'trial'
        || (request.resource.data.keys().hasAny(['advisoryFeeAmount'])
          && request.resource.data.advisoryFeeAmount > 0));
    }

    function isIntroducer() {
      return request.resource.data.keys().hasAll([
        'name',
        'feeSystem',
        'advisoryFeeEnabled',
        'note'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 40
      && (request.resource.data.feeSystem == 'sales10'
        || request.resource.data.feeSystem == 'pay10'
        || request.resource.data.feeSystem == 'higher10')
      && request.resource.data.advisoryFeeEnabled is bool
      && (!request.resource.data.keys().hasAny(['introductionFeeAmount'])
        || (request.resource.data.introductionFeeAmount is int
          && request.resource.data.introductionFeeAmount >= 0))
      && (!request.resource.data.keys().hasAny(['advisoryFeeAmount'])
        || (request.resource.data.advisoryFeeAmount is int
          && request.resource.data.advisoryFeeAmount >= 0))
      && ((request.resource.data.keys().hasAny(['deleted'])
          && request.resource.data.deleted == true)
        || request.resource.data.advisoryFeeEnabled == false
        || (request.resource.data.keys().hasAny(['advisoryFeeAmount'])
          && request.resource.data.advisoryFeeAmount > 0))
      && request.resource.data.note is string
      && request.resource.data.note.size() <= 500
      && (!request.resource.data.keys().hasAny(['deleted'])
        || request.resource.data.deleted is bool);
    }

    function isFixedExpense(document) {
      return request.resource.data.keys().hasAll([
        'month',
        'rent',
        'karaoke',
        'towel',
        'leasekin',
        'landline',
        'saibuGas',
        'usen'
      ])
      && request.resource.data.month == document
      && request.resource.data.month.matches('^\\d{4}-\\d{2}$')
      && request.resource.data.rent is int
      && request.resource.data.karaoke is int
      && request.resource.data.towel is int
      && request.resource.data.leasekin is int
      && request.resource.data.landline is int
      && request.resource.data.saibuGas is int
      && request.resource.data.usen is int
      && request.resource.data.rent >= 0
      && request.resource.data.karaoke >= 0
      && request.resource.data.towel >= 0
      && request.resource.data.leasekin >= 0
      && request.resource.data.landline >= 0
      && request.resource.data.saibuGas >= 0
      && request.resource.data.usen >= 0
      && (!request.resource.data.keys().hasAny(['utilities'])
        || (request.resource.data.utilities is int
          && request.resource.data.utilities >= 0))
      && (!request.resource.data.keys().hasAny(['communications'])
        || (request.resource.data.communications is int
          && request.resource.data.communications >= 0));
    }

    function isTrialCastRecord() {
      return request.resource.data.businessDate is string
      && request.resource.data.businessDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
      && request.resource.data.castId is string
      && request.resource.data.castId.size() > 0
      && request.resource.data.castName is string
      && request.resource.data.castName.size() > 0
      && request.resource.data.castName.size() <= 40
      && request.resource.data.introducerName is string
      && request.resource.data.introducerName.size() > 0
      && request.resource.data.introducerName.size() <= 40
      && request.resource.data.hourlyRate is int
      && request.resource.data.hourlyRate > 0
      && isNonNegativeNumber(request.resource.data.hours);
    }

    function isEmployeeSalary() {
      return request.resource.data.month is string
      && request.resource.data.month.matches('^\\d{4}-\\d{2}$')
      && request.resource.data.staffId is string
      && request.resource.data.staffId.size() > 0
      && request.resource.data.staffName is string
      && request.resource.data.staffName.size() > 0
      && request.resource.data.staffName.size() <= 40
      && request.resource.data.monthlySalary is int
      && request.resource.data.monthlySalary > 0;
    }

    function isLiquorCost() {
      return request.resource.data.brandName is string
      && request.resource.data.brandName.size() > 0
      && request.resource.data.brandName.size() <= 80
      && request.resource.data.costAmount is int
      && request.resource.data.costAmount >= 0
      && (!request.resource.data.keys().hasAny(['deleted'])
        || request.resource.data.deleted is bool);
    }

    function isCastSourceLink() {
      return request.resource.data.sourceSystem == 'club-genesis-pos'
        && request.resource.data.sourceCastId is string
        && request.resource.data.sourceCastId.size() > 0
        && request.resource.data.sourceCastId.size() <= 120
        && request.resource.data.memberId is string
        && request.resource.data.memberId.size() > 0
        && request.resource.data.personKey is string
        && request.resource.data.personKey.size() > 0
        && request.resource.data.status == 'linked';
    }

    function isCastLifecycleEvent() {
      return request.resource.data.eventId is string
        && request.resource.data.eventId.size() > 0
        && request.resource.data.eventId.size() <= 300
        && request.resource.data.sourceCastId is string
        && request.resource.data.sourceCastId.size() > 0
        && request.resource.data.sourceCastId.size() <= 120
        && (request.resource.data.eventType == 'entered'
          || request.resource.data.eventType == 'departed'
          || request.resource.data.eventType == 'trial')
        && request.resource.data.eventAt is string
        && request.resource.data.eventAt.size() <= 40
        && request.resource.data.businessDate is string
        && request.resource.data.businessDate.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isJsonImport() {
      return request.resource.data.submissionId is string
        && request.resource.data.submissionId.size() > 0
        && request.resource.data.submissionId.size() <= 200
        && request.resource.data.checksum is string
        && request.resource.data.checksum.size() > 0
        && request.resource.data.checksum.size() <= 128
        && request.resource.data.businessDate is string
        && request.resource.data.businessDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (request.resource.data.status == 'processing'
          || request.resource.data.status == 'completed'
          || request.resource.data.status == 'failed');
    }

    function isInternalMail() {
      return request.resource.data.sentDate is string
      && request.resource.data.sentDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
      && request.resource.data.subject is string
      && request.resource.data.subject.size() > 0
      && request.resource.data.subject.size() <= 80
      && request.resource.data.body is string
      && request.resource.data.body.size() > 0
      && request.resource.data.body.size() <= 2000
      && (request.resource.data.fromRole == 'shop'
        || request.resource.data.fromRole == 'accounting')
      && (request.resource.data.toRole == 'shop'
        || request.resource.data.toRole == 'accounting')
      && request.resource.data.fromRole != request.resource.data.toRole
      && request.resource.data.fromUid is string
      && request.resource.data.fromUid.size() > 0
      && request.resource.data.fromEmail is string
      && request.resource.data.fromEmail.size() <= 120
      && request.resource.data.readByShop is bool
      && request.resource.data.readByAccounting is bool
      && (!request.resource.data.keys().hasAny(['readAtShop'])
        || request.resource.data.readAtShop is timestamp)
      && (!request.resource.data.keys().hasAny(['readAtAccounting'])
        || request.resource.data.readAtAccounting is timestamp);
    }

    function isInternalMailReadStatusUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'readByShop',
        'readByAccounting',
        'readAtShop',
        'readAtAccounting',
        'updatedAt'
      ])
      && (!request.resource.data.keys().hasAny(['readByShop'])
        || request.resource.data.readByShop is bool)
      && (!request.resource.data.keys().hasAny(['readByAccounting'])
        || request.resource.data.readByAccounting is bool)
      && (!request.resource.data.keys().hasAny(['readAtShop'])
        || request.resource.data.readAtShop is timestamp)
      && (!request.resource.data.keys().hasAny(['readAtAccounting'])
        || request.resource.data.readAtAccounting is timestamp);
    }

    match /dailyReports/{document} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /dailyReports-dev/{document} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /dailyClosings/{document} {
      allow read: if signedIn();
      allow create, update: if signedIn() && ((userRole() == 'shop' || userRole() == 'accounting') || isSelfSubmittedClosing() || isSelfFinalizedClosing());
      allow delete: if signedIn() && userRole() == 'accounting';
    }

    match /dailyClosings-dev/{document} {
      allow read: if signedIn();
      allow create, update: if signedIn() && ((userRole() == 'shop' || userRole() == 'accounting') || isSelfSubmittedClosing() || isSelfFinalizedClosing());
      allow delete: if signedIn() && userRole() == 'accounting';
    }

    match /staffMembers/{document} {
      allow read: if signedIn();
      allow create, update: if signedIn() && isStaffMember();
      allow delete: if false;
    }

    match /staffMembers-dev/{document} {
      allow read: if signedIn();
      allow create, update: if signedIn() && isStaffMember();
      allow delete: if false;
    }

    match /castMembers/{document} {
      allow read: if signedIn();
      allow create, update: if signedIn() && isCastMember();
      allow delete: if false;
    }

    match /castMembers-dev/{document} {
      allow read: if signedIn();
      allow create, update: if signedIn() && isCastMember();
      allow delete: if false;
    }

    match /castSourceLinks/{document} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && (userRole() == 'shop' || userRole() == 'accounting')
        && isCastSourceLink();
      allow delete: if false;
    }

    match /castSourceLinks-dev/{document} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && (userRole() == 'shop' || userRole() == 'accounting')
        && isCastSourceLink();
      allow delete: if false;
    }

    match /castLifecycleEvents/{document} {
      allow read: if signedIn();
      allow create: if signedIn()
        && (userRole() == 'shop' || userRole() == 'accounting')
        && isCastLifecycleEvent();
      allow update: if false;
      allow delete: if false;
    }

    match /castLifecycleEvents-dev/{document} {
      allow read: if signedIn();
      allow create: if signedIn()
        && (userRole() == 'shop' || userRole() == 'accounting')
        && isCastLifecycleEvent();
      allow update: if false;
      allow delete: if false;
    }

    match /jsonImports/{document} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && (userRole() == 'shop' || userRole() == 'accounting')
        && isJsonImport();
      allow delete: if false;
    }

    match /jsonImports-dev/{document} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && (userRole() == 'shop' || userRole() == 'accounting')
        && isJsonImport();
      allow delete: if false;
    }

    match /introducers/{document} {
      allow read: if signedIn();
      allow create, update: if signedIn() && isIntroducer();
      allow delete: if false;
    }

    match /introducers-dev/{document} {
      allow read: if signedIn();
      allow create, update: if signedIn() && isIntroducer();
      allow delete: if false;
    }

    match /fixedExpenses/{document} {
      allow read: if signedIn();
      allow create, update: if signedIn() && isFixedExpense(document);
      allow delete: if false;
    }

    match /fixedExpenses-dev/{document} {
      allow read: if signedIn();
      allow create, update: if signedIn() && isFixedExpense(document);
      allow delete: if false;
    }

    match /liquorCosts/{document} {
      allow read: if signedIn();
      allow create, update: if signedIn() && isLiquorCost();
      allow delete: if signedIn();
    }

    match /liquorCosts-dev/{document} {
      allow read: if signedIn();
      allow create, update: if signedIn() && isLiquorCost();
      allow delete: if signedIn();
    }

    match /trialCastRecords/{document} {
      allow read: if signedIn();
      allow create, update: if signedIn() && isTrialCastRecord();
      allow delete: if false;
    }

    match /trialCastRecords-dev/{document} {
      allow read: if signedIn();
      allow create, update: if signedIn() && isTrialCastRecord();
      allow delete: if false;
    }

    match /employeeSalaries/{document} {
      allow read: if signedIn();
      allow create, update: if signedIn() && isEmployeeSalary();
      allow delete: if false;
    }

    match /employeeSalaries-dev/{document} {
      allow read: if signedIn();
      allow create, update: if signedIn() && isEmployeeSalary();
      allow delete: if false;
    }

    match /internalMails/{document} {
      allow read: if signedIn();
      allow create: if signedIn() && isInternalMail() && request.resource.data.fromUid == request.auth.uid;
      allow update: if signedIn() && (isInternalMail() || isInternalMailReadStatusUpdate());
      allow delete: if false;
    }

    match /internalMails-dev/{document} {
      allow read: if signedIn();
      allow create: if signedIn() && isInternalMail() && request.resource.data.fromUid == request.auth.uid;
      allow update: if signedIn() && (isInternalMail() || isInternalMailReadStatusUpdate());
      allow delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
